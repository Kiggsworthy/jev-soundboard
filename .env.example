# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Jev (TypeSafe) makes every clip decision. Get a key at https://typesafe.ai
TYPESAFE_API_KEY=your-typesafe-key-here

# Speech-to-text, the only non-Jev piece (OpenAI Realtime transcription).
OPENAI_API_KEY=your-openai-key-here

# Only for the Discord bot (docs/DISCORD.md).
DISCORD_BOT_TOKEN=your-discord-bot-token-here

# Any setting can also go here as JEVBOARD_<NAME>, e.g.:
# JEVBOARD_LISTEN_DEVICE=BlackHole 2ch
# JEVBOARD_OUTPUT_DEVICE=BlackHole 16ch
# JEVBOARD_TRIGGER=normal
